#include "libft.h"
#include <stdlib.h>

// Step 1: count how many words 's' holds - a word is a maximal run
//         of characters that are not the delimiter 'c'.

// Step 2: ft_calloc an array of (word count + 1) char pointers, so
//         every unused slot is already NULL for cleanup / the
//         terminating NULL.

// Step 3: walk 's' again: skip runs of 'c', measure each word, and
//         ft_substr it into the next array slot.

// Step 4: if any ft_substr fails, free every word allocated so far
//         and the array itself, then return NULL.

// Step 5: return the NULL-terminated array.

// A new word begins at each character that is NOT a delimiter but
// whose previous character IS a delimiter (or which is the very
// first character).  Count those "word starts" in a single pass.
static size_t	ft_wordcount(char const *str, char delim)
{
	size_t	cnt;
	size_t	idx;

	cnt = 0;
	idx = 0;
	while (str[idx] != '\0')
	{
		if (str[idx] != delim && (idx == 0 || str[idx - 1] == delim))
			++cnt;
		++idx;
	}
	return (cnt);
}

static void	ft_freearray(char **arr)
{
	size_t	idx;

	idx = 0;
	while (arr[idx] != NULL)
	{
		free(arr[idx]);
		++idx;
	}
	free(arr);
}

static int	ft_fillarray(char **arr, char const *s, char delim)
{
	size_t	pos;
	size_t	idx;
	size_t	wln;

	pos = 0;
	idx = 0;
	while (s[idx] != '\0')
	{
		while (s[idx] == delim)
			++idx;
		wln = 0;
		while (s[idx + wln] != '\0' && s[idx + wln] != delim)
			++wln;
		if (wln > 0)
		{
			arr[pos] = ft_substr(s, (unsigned int)idx, wln);
			if (arr[pos] == NULL)
				return (0);
			++pos;
		}
		idx += wln;
	}
	return (1);
}

char	**ft_split(char const *s, char c)
{
	char	**arr;

	if (!s)
		return (NULL);
	arr = (char **)ft_calloc(ft_wordcount(s, c) + 1, sizeof(char *));
	if (!arr)
		return (NULL);
	if (ft_fillarray(arr, s, c) == 0)
	{
		ft_freearray(arr);
		return (NULL);
	}
	return (arr);
}
